# ==============================================================================
# ProcureAI Backend — Environment Variables
# ==============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================================================

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed origins + regex for Vercel deployments
# ---------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ORIGIN_REGEX=https://.*\\.vercel\\.app

# ---------------------------------------------------------------------------
# LLM API (OpenAI-compatible)
# Options: OpenAI / DeepSeek / Qwen / any OpenAI-compatible API
#
#   Set OPENAI_API_KEY to enable AI-powered intent parsing & ranking.
#   Without it, the system falls back to heuristic rules (still functional).
#
#   For DeepSeek (cheap, CN-friendly):
#     OPENAI_BASE_URL=https://api.deepseek.com
#     LLM_MODEL=deepseek-chat
#
#   For OpenAI:
#     OPENAI_BASE_URL=https://api.openai.com/v1
#     LLM_MODEL=gpt-4o
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# ---------------------------------------------------------------------------
# Embedding model (local, free) — used by ChromaDB for semantic search
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3

# ---------------------------------------------------------------------------
# ChromaDB persistence directory
# ---------------------------------------------------------------------------
CHROMA_PERSIST_DIR=./chroma_data

# ---------------------------------------------------------------------------
# PostgreSQL（数据库同学建表后填入）
# ---------------------------------------------------------------------------
# Preferred: a complete PostgreSQL/Supabase connection string used by database.py.
DATABASE_URL=
# Optional legacy fields. Keep these only when your deployment composes its own URL.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=procureai
DB_USER=procureai
DB_PASSWORD=

# ---------------------------------------------------------------------------
# Optional marketplace quote APIs (standard-product comparison only)
#
# With all fields empty, no marketplace API call is made. Germany/default
# requests use Idealo plus web search; explicit non-German requests use only
# country-qualified web search. Do not add credentials for a
# marketplace unless your organisation is authorised to use that API.
# ---------------------------------------------------------------------------

# SerpApi Google Shopping (primary optional source). A valid paid/free-trial
# SerpApi key is required; leave blank to disable every request. Country is
# mapped through supported Google Shopping markets, never forwarded verbatim.
SERPAPI_API_KEY=
SERPAPI_COUNTRY=de
# Leave these blank to use the language/domain mapped from the selected country.
SERPAPI_LANGUAGE=
SERPAPI_GOOGLE_DOMAIN=
SERPAPI_TIMEOUT_SECONDS=8
SERPAPI_CACHE_TTL_SECONDS=180

# Official eBay Browse API. Both values are required to enable it.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_DE

# Generic authorised marketplace connector. It makes a read-only GET request
# by default with query, limit and country parameters. Expected response:
# {"items": [{"title": "...", "url": "...", "price": {"value": "12.50", "currency": "EUR"}}]}
MARKETPLACE_API_URL=
MARKETPLACE_API_KEY=
MARKETPLACE_API_METHOD=GET
MARKETPLACE_API_KEY_HEADER=Authorization
MARKETPLACE_API_KEY_PREFIX=Bearer

# Query behaviour. Marketplace results skip slower page scraping only after
# this many relevant priced EUR items are returned. Empty/failed API and Idealo
# results are not cached, so later requests can retry normally.
MARKETPLACE_API_TIMEOUT_SECONDS=4
MARKETPLACE_CACHE_TTL_SECONDS=120
MARKETPLACE_PRICED_SHORT_CIRCUIT_MIN=3
IDEALO_TIMEOUT_SECONDS=20
